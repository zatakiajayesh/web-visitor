# Application Environment Configuration
# Copy this file to .env and update with your settings

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=web_visitor
DB_PORT=3306

# Application Settings
APP_NAME=Web Visitor Tracker
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/web-visitor

# Session Configuration
SESSION_TIMEOUT=3600
SESSION_HANDLER=file

# Cookie Settings
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax

# Logging
LOG_LEVEL=info
LOG_PATH=logs/app.log

# Cache Configuration
CACHE_DRIVER=file
CACHE_TTL=3600

# Security
APP_KEY=
CSRF_TOKEN_LENGTH=32

# Features
ANALYTICS_ENABLED=true
EMAIL_ALERTS_ENABLED=false
REAL_TIME_TRACKING=true

# Email Configuration (Optional)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=admin@example.com

# Third-party Services (Optional)
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# Development Only
DEBUG_TOOLBAR=false
QUERY_LOGGING=false
